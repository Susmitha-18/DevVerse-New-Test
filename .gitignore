# =============================================
# DevVerse — Root .gitignore
# =============================================

# ---- OS Generated ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity

# ---- Environment Variables ----
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# ---- Build Outputs ----
dist/
build/
out/
.next/
.nuxt/
.vite/

# ---- TypeScript ----
*.tsbuildinfo
*.d.ts.map

# ---- Logs ----
logs/
*.log
combined.log
error.log

# ---- Coverage ----
coverage/
.nyc_output/

# ---- Electron ----
out/
release/
*.dmg
*.exe
*.AppImage
*.snap
*.deb
*.rpm

# ---- IDE / Editors ----
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Temporary ----
tmp/
temp/
*.tmp
*.temp

# ---- MongoDB ----
*.mongodb

# ---- Testing ----
jest-results/
test-results/
